{
  "name": "aframe-material-redux",
  "main": "dist/aframe-material.min.js",
  "description": "Material design (inputs, keyboards, checkbox, radio button) for A-Frame (https://aframe.io).",
  "version": "0.2.0",
  "license": "MIT",
  "scripts": {
    "watch": "cross-env webpack --progress --watch",
    "build": "cross-env webpack --progress",
    "start": "cross-env NODE_ENV=development webpack serve --progress --hot --host 0.0.0.0",
    "dist": "npm run dist:max && npm run dist:min",
    "dist:max": "cross-env npm run build",
    "dist:min": "cross-env NODE_ENV=production npm run build",
    "upgrade": "npx npm-check-updates -u && npm install --legacy-peer-deps"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "babel-jest": "^30.2.0",
    "babel-loader": "^9.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "gh-pages": "^6.3.0",
    "gm": "^1.25.1",
    "jest": "^30.2.0",
    "object-assign": "^4.1.1",
    "open": "10.2.0",
    "shx": "^0.4.0",
    "style-loader": "^4.0.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.0",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "keywords": [
    "aframe",
    "aframe-component",
    "webvr",
    "vr"
  ]
}
